# ---------------------------------------------------------------------------
# DWD Expense Manager — environment variables
# Copy to .env.local for local use; set the same names in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API / Data API). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_…) or legacy "anon" key. Safe for the browser —
# all access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. Secret key (sb_secret_…) or legacy "service_role" key.
# Used for: admin user management in the app, the historical import and create-admin scripts.
# NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: timezone used for "today" and report periods (default Asia/Karachi)
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi

# Optional overrides for the historical import (defaults point at the DWD sheet)
# SHEET_PUBLISHED_ID=2PACX-1vT4mUtPHMK1oWXl7l5PNPUvSwxktl2oavqDDiqNwi6Bn3fK50gJNRf3Y-I2uaMW2nWwpWrRxrXACwl2
# SHEET_LEDGER_GID=884284817
# SHEET_SUMMARY_GID=946165812
